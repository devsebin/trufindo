    "@types/useragent": "^2.3.4",
    "copyfiles": "^2.4.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^3.4.1",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-watch": "^4.6.2",
    "typescript": "^6.0.3"
  },
